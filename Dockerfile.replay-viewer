# Build the static replay viewer with the same pinned Nim and Bitworld sources
# as the native game. The output is architecture-neutral WebAssembly even
# though this reproducible toolchain container runs as linux/amd64.
FROM emscripten/emsdk:4.0.15 AS replay-viewer-builder

RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates curl git && \
  rm -rf /var/lib/apt/lists/* && \
  curl -fsSL \
    -o /usr/local/bin/nimby \
    https://github.com/treeform/nimby/releases/download/0.1.27/nimby-Linux-X64 && \
  echo "3b3084394bd26b09f84a3f82389f075221c8784893238390939d71dd66ac9e8b  /usr/local/bin/nimby" | sha256sum -c - && \
  chmod +x /usr/local/bin/nimby && \
  nimby use 2.2.4

ENV PATH="/root/.nimby/nim/bin:$PATH"

WORKDIR /workspace/pommerman
COPY nimby.lock .
RUN nimby --global sync nimby.lock

COPY . .
# The SAME src/pommerman/sim.nim the native server runs, compiled to wasm. The
# marker splices below give the bundled page its own <script src> for the wire
# constants, the shared chrome and the static adapter -- broadcast_core.js and
# pommerman_replay.js are loaded by the Worker via importScripts, so the page
# must NOT carry script tags for them.
RUN nim c -d:emscripten replay-viewer/pommerman_replay.nim && \
  nim c -r --hints:off -o:/tmp/gen_wire_constants tools/gen_wire_constants.nim \
    > replay-viewer/dist/wire_constants.js && \
  cp client/broadcast_core.js replay-viewer/dist/broadcast_core.js && \
  cp client/chrome_common.js replay-viewer/dist/chrome_common.js && \
  cp data/font.ttf replay-viewer/dist/font.ttf && \
  cp replay-viewer/static_replay.js replay-viewer/dist/static_replay.js && \
  cp replay-viewer/static_replay_worker.js \
    replay-viewer/dist/static_replay_worker.js && \
  sed -e 's|<!-- WIRE_CONSTANTS -->|<script src="./wire_constants.js"></script>|' \
      -e 's|<!-- CHROME_COMMON -->|<script src="./chrome_common.js"></script>|' \
      -e 's|<!-- BROADCAST_CORE -->|<script src="./static_replay.js"></script>|' \
    client/replay_broadcast.html > replay-viewer/dist/index.html && \
  cp data/bomber_red.png data/bomber_blue.png \
    data/bomber_red_crown.png data/bomber_blue_crown.png \
    data/soldier_red.png data/soldier_blue.png \
    data/bomb.png data/powerup_range.png data/powerup_kick.png \
    data/arena_floor.png data/ascii.png replay-viewer/dist/ && \
  mkdir -p replay-viewer/dist/atlas && \
  cp data/atlas/nes-pixel.ttf replay-viewer/dist/atlas/ && \
  mkdir -p replay-viewer/dist/art/lockerroom replay-viewer/dist/art/walls && \
  cp client/art/lockerroom/bg.jpg client/art/lockerroom/*.webp \
    replay-viewer/dist/art/lockerroom/ && \
  cp client/art/walls/wall_h.jpg client/art/walls/wall_v.jpg \
    replay-viewer/dist/art/walls/ && \
  rm -rf replay-viewer/dist/nimcache && \
  test -f replay-viewer/dist/pommerman_replay.wasm && \
  test -f replay-viewer/dist/pommerman_replay.js && \
  test -f replay-viewer/dist/static_replay_worker.js && \
  test -f replay-viewer/dist/index.html && \
  test -s replay-viewer/dist/wire_constants.js && \
  grep -q '^window.POM_WIRE={' replay-viewer/dist/wire_constants.js && \
  grep -q 'wire_constants.js' replay-viewer/dist/index.html && \
  test -s replay-viewer/dist/chrome_common.js && \
  grep -q 'window.ChromeCommon' replay-viewer/dist/chrome_common.js && \
  grep -q 'chrome_common.js' replay-viewer/dist/index.html && \
  grep -q 'static_replay.js' replay-viewer/dist/index.html && \
  grep -q 'static_replay_worker.js' replay-viewer/dist/static_replay.js && \
  grep -q 'pommerman_replay.js' replay-viewer/dist/static_replay_worker.js && \
  ! grep -q '<script src="./broadcast_core.js"></script>' replay-viewer/dist/index.html && \
  ! grep -q '<script src="./pommerman_replay.js"></script>' replay-viewer/dist/index.html && \
  test -f replay-viewer/dist/bomber_red.png && \
  test -f replay-viewer/dist/bomber_blue.png && \
  test -f replay-viewer/dist/bomber_red_crown.png && \
  test -f replay-viewer/dist/bomber_blue_crown.png && \
  test -f replay-viewer/dist/bomb.png && \
  test -f replay-viewer/dist/powerup_range.png && \
  test -f replay-viewer/dist/powerup_kick.png && \
  test -f replay-viewer/dist/arena_floor.png && \
  test -f replay-viewer/dist/art/walls/wall_h.jpg && \
  test -f replay-viewer/dist/art/lockerroom/bg.jpg && \
  test -f replay-viewer/dist/art/lockerroom/red_1.webp && \
  test -f replay-viewer/dist/art/lockerroom/blue_6.webp
